document.addEventListener('DOMContentLoaded', function () {
  const destaque = document.querySelector('#imagem-destaque');
  const legenda = document.querySelector('#legenda-destaque');
  const miniaturas = document.querySelectorAll('.miniatura');

  if (destaque && miniaturas.length > 0) {
    miniaturas.forEach(function (img) {
      img.addEventListener('click', function () {
        destaque.src = img.src;
        if (legenda) {
          legenda.textContent = img.getAttribute('alt') || 'Projeto em destaque';
        }

        miniaturas.forEach(function (mini) {
          mini.classList.remove('ativa');
        });

        img.classList.add('ativa');
      });
    });
  }

  const formContato = document.querySelector('#form-contato');
  const mensagemFeedback = document.querySelector('#feedback-mensagem');

  if (formContato) {
    formContato.addEventListener('submit', function (event) {
      event.preventDefault();

      const nomeInput = document.querySelector('#nome');
      const nome = nomeInput ? nomeInput.value.trim() || 'Usuário' : 'Usuário';

      if (mensagemFeedback) {
        mensagemFeedback.textContent = `Obrigado, ${nome}! Sua mensagem foi enviada com sucesso.`;
        mensagemFeedback.classList.add('sucesso');
        mensagemFeedback.style.display = 'block';
      }

      formContato.reset();
    });
  }

  const cepInput = document.querySelector('#cep');
  const btnBuscarCep = document.querySelector('#buscar-cep');
  const enderecoMapa = document.querySelector('#endereco-mapa');

  function initMap(lat, lng, label) {
    const mapBox = document.querySelector('#mapa-contato');
    if (!mapBox || typeof window.L === 'undefined') return;

    const map = L.map('mapa-contato').setView([lat, lng], 15);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    L.marker([lat, lng]).addTo(map)
      .bindPopup(label)
      .openPopup();
  }

  async function buscarCep() {
    if (!cepInput || !enderecoMapa) return;

    const cep = cepInput.value.replace(/\D/g, '');
    if (!cep || cep.length !== 8) {
      enderecoMapa.textContent = 'Digite um CEP válido com 8 números.';
      return;
    }

    try {
      const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
      const data = await response.json();

      if (data.erro) {
        enderecoMapa.textContent = 'CEP não encontrado. Verifique e tente novamente.';
        return;
      }

      const enderecoCompleto = `${data.logradouro || 'Rua não informada'}, ${data.bairro || 'Bairro não informado'} - ${data.localidade || 'Cidade não informada'} / ${data.uf || 'UF'}`;
      enderecoMapa.textContent = enderecoCompleto;

      const query = `${data.logradouro || ''} ${data.bairro || ''} ${data.localidade || ''} ${data.uf || ''}`;
      const geoResponse = await fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`);
      const geoData = await geoResponse.json();

      if (geoData && geoData.length > 0) {
        const lat = parseFloat(geoData[0].lat);
        const lng = parseFloat(geoData[0].lon);
        initMap(lat, lng, enderecoCompleto);
      } else {
        initMap(-23.5505, -46.6333, 'Localização padrão: São Paulo - SP');
      }
    } catch (error) {
      enderecoMapa.textContent = 'Não foi possível consultar o CEP no momento.';
    }
  }

  if (btnBuscarCep) {
    btnBuscarCep.addEventListener('click', buscarCep);
  }

  if (cepInput) {
    cepInput.addEventListener('keydown', function (event) {
      if (event.key === 'Enter') {
        buscarCep();
      }
    });
  }

  if (document.querySelector('#mapa-contato')) {
    initMap(-23.5505, -46.6333, 'Endereço de encontro: Rua das Flores, 250 - Centro, São Paulo - SP');
  }
});
